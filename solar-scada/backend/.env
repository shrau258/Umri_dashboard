# Application Settings
APP_NAME="Solar SCADA Dashboard"
APP_VERSION="1.0.0"
DEBUG=true
SECRET_KEY="your-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings (SQL Server)
DATABASE_URL="mssql+pyodbc://sa:YourPassword@localhost:1433/SolarSCADA?driver=ODBC+Driver+17+for+SQL+Server"

# Redis Settings
REDIS_URL="redis://localhost:6379/0"

# Modbus TCP Settings
MODBUS_HOST="192.168.1.100"
MODBUS_PORT=502
MODBUS_UNIT_ID=1
MODBUS_TIMEOUT=5
MODBUS_RETRY_COUNT=3
MODBUS_RETRY_DELAY=2

# Weather Station Settings
WMS1_HOST="192.168.1.101"
WMS1_PORT=502
WMS2_HOST="192.168.1.102"
WMS2_PORT=502

# Inverter Settings
INVERTER_COUNT=10
INVERTER_BASE_ADDRESS=1

# Data Acquisition Interval (seconds)
DATA_ACQUISITION_INTERVAL=5
WEATHER_ACQUISITION_INTERVAL=30

# Alarm Settings
ALARM_CHECK_INTERVAL=10
ALARM_RETENTION_DAYS=365

# Report Settings
REPORT_GENERATION_TIME="00:00"
REPORT_RETENTION_DAYS=3650

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# WebSocket Settings
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000